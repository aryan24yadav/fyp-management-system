# ---- Server ----
PORT=4000
NODE_ENV=development
# Set to 1 when running behind a reverse proxy / PaaS (Render, Railway, Nginx)
# so rate limiting sees the real client IP.
TRUST_PROXY=

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=projectManagementSystem

# ---- Auth ----
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
# Cookie lifetime in days (keep it in sync with JWT_EXPIRE)
COOKIE_EXPIRE=7
# Public /auth/register creates Student accounts only. Keep false unless needed.
ALLOW_PUBLIC_REGISTRATION=false

# ---- Frontend (CORS + links in e-mails). Comma-separate multiple origins;
# the FIRST one is used in e-mail links.
FRONTEND_URL=http://localhost:5173

# ---- SMTP (password reset + notification e-mails) ----
# Either set SMTP_SERVICE (e.g. gmail) ...
SMTP_SERVICE=gmail
# ... or SMTP_HOST + SMTP_PORT
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_MAIL=your-email@gmail.com
# For Gmail use an App Password, not your account password
SMTP_PASSWORD=your-app-password
SMTP_FROM="FYP Management System <your-email@gmail.com>"

# ---- Rate limits (requests per 15 minutes per IP) ----
API_RATE_LIMIT=1000
AUTH_RATE_LIMIT=20

# ---- First admin account (used by `npm run seed:admin`) ----
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
